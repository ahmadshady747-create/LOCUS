{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOCUS",
  "version": "0.1.0-alpha",
  "identifier": "dev.locus.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LOCUS",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      },
      {
        "label": "spotlight",
        "title": "LOCUS Spotlight",
        "url": "index.html?window=spotlight",
        "width": 750,
        "height": 450,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNDYxQkNGQjQwOTZBOEYKUldTUGFnbTB6eHRHZjdZMXlFVEUvVlRhcEh4MUJWRFRodlJJNENzNXQ4b2NUaGdMM01LTDhGQ3YK",
      "endpoints": [
        "https://github.com/ahmadshady747-create/LOCUS/releases/latest/download/latest.json"
      ]
    }
  }
}
